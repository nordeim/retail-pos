# VeloxPOS — local development environment
# The path is schema-anchored: file:../db/custom.db resolves to <repo>/db/custom.db
# for the Prisma CLI AND the runtime (src/lib/db-path.ts applies the same rule).
DATABASE_URL="file:../db/custom.db"

# Session/HMAC secret. Generate a real one for any shared deployment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NOTE: this EXAMPLE value is production-FATAL by design — the boot guard
# (src/instrumentation.ts) refuses to start a production server signed with
# it. Generate your own; never run production on a shared example secret.
AUTH_SECRET="dev-only-veloxpos-secret-change-me"

# The site's public origin (src/lib/site.ts reads it for metadata/sitemap).
# Used by Next's metadata; set it to wherever the app is actually served.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Set to "1" ONLY on a production deploy that deliberately wants the reset
# link carried by the forgot-password API response (no-SMTP self-hosted
# recovery). Production defaults to OFF — the response never carries the
# one-shot reset token unless this flag opts in.
# RESET_INAPP_DELIVERY="1"

# Trusted reverse-proxy depth for the auth rate limiters' client-IP
# selection (src/lib/auth.ts resolveClientIp). 0 = one trusted proxy
# (rightmost x-forwarded-for hop); set to your real proxy chain length.
# AUTH_PROXY_HOPS="0"

# Seed defaults (used by `bun run db:seed` only — never read by src/)
SEED_OWNER_EMAIL="owner@veloxpos.local"
SEED_OWNER_NAME="Cesar Martínez"
